{
  "name": "@scriptcamilo/init-deno-nestjs",
  "version": "0.1.1",
  "exports": "./main.ts",
  "license": "MIT",
  "tasks": {
    "dev": "deno run -A --watch main.ts",
    "start": "deno run -A main.ts",
    "check": "deno check main.ts tests/*.ts",
    "lint": "deno lint",
    "fmt": "deno fmt",
    "test": "deno test -A",
    "publish:dry": "deno publish --dry-run"
  },
  "fmt": {
    "semiColons": true,
    "singleQuote": false,
    "indentWidth": 2
  },
  "lint": {
    "rules": {
      "tags": ["recommended"]
    }
  },
  "publish": {
    "exclude": ["tests/"]
  }
}
